# This dockerfile adds dvd support. Current version of the script doesn't support this, it can only be needed for
# developers working on it.

# build container
FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.su* ./
RUN if [ -f go.sum ]; then go mod download; fi
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /video-optimizer-daemon .

# run container
FROM debian:bookworm-slim

# install multimedia tools
RUN sed -i 's/main/main contrib/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    mediainfo \
    handbrake-cli \
    mkvtoolnix \
    libdvd-pkg \
    && DEBIAN_FRONTEND=noninteractive dpkg-reconfigure libdvd-pkg \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# The daemon must run as the owner of the media library: it replaces files in
# place and cannot chown. Match PUID/PGID to the user who owns the media.
ARG PUID=1000
ARG PGID=1000
RUN groupadd -g ${PGID} app && \
    useradd -u ${PUID} -g app -m app

WORKDIR /app
USER app
COPY --from=builder --chown=app:app /video-optimizer-daemon .

CMD ["./video-optimizer-daemon"]
